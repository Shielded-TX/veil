{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "outDir": "./dist"
    },
    "include": [
        "src/**/*",
        "../artifacts/**/*",
        "../lib/merkle/src/**/*"
    ],
    "exclude": [
        "../lib/merkle/src/test.ts"
    ]
}
